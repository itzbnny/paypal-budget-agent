{
  "name": "paypal-budget-agent",
  "version": "0.1.0",
  "private": true,
  "description": "An AI budgeting agent for PayPal users, built for the PayPal AI Hackathon",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "probe:paypal": "tsx --env-file=.env scripts/probe-paypal.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
